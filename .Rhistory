#trend ----
#read original method issue capture
orimcap<- read.csv("/Users/lwei/Library/CloudStorage/OneDrive-UniversityofGlasgow/CIHR/manuscript/co-authors/MH/data/trends_withMH2.csv") #original method issue capture
smy <- orimcap %>%
mutate(yr = str_extract(Paper.Citation, "(19|20)[0-9]{2,2}")) %>%
mutate(shrt = if_else(is.na(yr), firstauthor, paste0(firstauthor, ", ", yr))) %>%
mutate(shrt = if_else(str_detect(shrt, ";"), "Anonymous, 2020", shrt)) %>%
mutate(yr = if_else(firstauthor == "McBurney", "2022", yr),
Reference.ID = as.character(Reference.ID )) %>%
filter(! Reference.ID %in% c("544866", "544993")) #updated, removed 2 papers as readme to make the trend plot
smy[is.na(smy)] <- 0
freq(smy$yr)
smy <- smy %>%
mutate(bias_confounding = if_else(info_bias == 1 | misclass_bias == 1 | selection_bias == 1 | confounding ==1 | bias ==1 , 1, 0),
data_quality_accuracy = if_else(missing_data == 1| Censor == 1 | pre_processing == 1 | icd == 1 | data_quality == 1, 1, 0),
study_design_analytics = if_else(drug_exposures == 1 | stats_model == 1 | causation == 1 | epi_cohort == 1 | emulate_trial == 1, 1, 0),
equity_validity_reporting = if_else(social_determinants == 1 | External_validity == 1 | reporting == 1, 1, 0),
data_integration_interoperability = if_else(linkage == 1 | distributed == 1 | harmonise_pts_data ==1, 1, 0),
others = if_else(other == 1 | uncertainty == 1 | higher_level == 1, 1, 0))
#not add heterogeneity and effect est, as they are more like the research question rather than the challenge.
smy2<- smy %>%
mutate(bias_all = if_else(info_bias == 1 | misclass_bias == 1 | selection_bias == 1 | bias ==1 , 1, 0),
data_quality2 = if_else(missing_data == 1| Censor == 1 | data_quality == 1, 1, 0),
causal_infer = if_else(causation == 1 | emulate_trial == 1, 1, 0)) %>%
summarise(across(where(is.numeric), sum)) %>%
select(icd, distributed, reporting, linkage, confounding, pre_processing, External_validity, drug_exposures,
social_determinants, others, causal_infer, stats_model, data_quality2, epi_cohort, data_quality_accuracy,
study_design_analytics, equity_validity_reporting, data_integration_interoperability, bias_all, harmonise_pts_data, bias_confounding)
# Step 1: Group by year and summarise
smy_summary <- smy %>%
group_by(yr) %>%
summarise(across(where(is.numeric), sum, na.rm = TRUE)) %>%
select(yr, bias_confounding, data_quality_accuracy, study_design_analytics, equity_validity_reporting, data_integration_interoperability, others)
smy2<- smy %>%
mutate(bias_all = if_else(info_bias == 1 | misclass_bias == 1 | selection_bias == 1 | bias ==1 , 1, 0)) %>%
summarise(across(where(is.numeric), sum))
#get the counts for method challenges from smy2 here for table 1
# Step 2: Reshape into long format
smy_long <- smy_summary %>%
pivot_longer(cols = -yr, names_to = "category", values_to = "count")
# Ensure yr is numeric
smy_long <- smy_long %>%
mutate(yr = as.numeric(as.character(yr))) %>%
filter(!yr == "2023")
# Step 1: Fill in missing years per category with 0 count
all_years <- seq(min(smy_long$yr), max(smy_long$yr), by = 1)
smy_long_filled <- smy_long %>%
complete(yr = all_years, category, fill = list(count = 0))
# Step 2: Calculate total counts per category (from original data, not filled)
totals <- smy_long %>%
group_by(category) %>%
summarise(total = sum(count, na.rm = TRUE)) %>%
left_join(
smy_long_filled %>% group_by(category) %>% filter(yr == max(yr)),
by = "category"
)
#modify the color and resolve number overlap
trend <- ggplot(smy_long_filled,
aes(x = yr, y = count, colour = category, group = category)) +
geom_line(size = 1) +
geom_point(size = 2) +
# point labels
geom_text(aes(label = count),
vjust = -0.5, size = 3, show.legend = FALSE) +
# non-overlapping "Total: ..." labels at the right
geom_text_repel(
data = totals,
aes(x = yr + 0.3, y = count,
label = paste0("Total: ", total),
colour = category),
hjust = 0,
direction = "y",
nudge_x = 0.2,
size = 3,
segment.size = 0.2,
show.legend = FALSE
) +
labs(
title = "Figure 2. Trends of Methodological Challenges Across Years",
x = "Year",
y = "Count",
colour = "Category"
) +
theme_minimal() +
# custom colours (no red/green)
scale_colour_manual(values = c(
bias_confounding              = "#1f77b4",  # blue
data_integration_interoperability      = "#ff7f0e",  # orange
data_quality_accuracy         = "#9467bd",  # purple
equity_validity_reporting = "#8c564b",  # brown
others                        = "#17becf",  # teal
study_design_analytics        = "#e377c2"   # pink
)) +
# show every year
scale_x_continuous(breaks = all_years,
limits = c(min(all_years), max(all_years) + 1))
trend
