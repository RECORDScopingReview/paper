# Combine 2022 and 2023 into one group
df <- smy %>%
mutate(yr_group = ifelse(yr %in% c(2022, 2023), "2022-2023", as.character(yr)))
# Convert to long format
df_long <- df %>%
pivot_longer(
cols = c(bias_confounding, data_quality_accuracy, study_design_analytics,
equity_validity_reporting, data_integration_interoperability, others),
names_to = "Methodological_Issue",
values_to = "Present"
)
df_long <- df_long %>%
mutate(Methodological_Issue = factor(Methodological_Issue,
levels = c(
"bias_confounding",
"data_quality_accuracy",
"study_design_analytics",
"equity_validity_reporting",
"data_integration_interoperability",
"others"
)))
htmap <- ggplot(df_long, aes(x = Methodological_Issue, y = firstauthor, fill = factor(Present))) +
geom_tile(color = "white") +
facet_wrap(~ yr_group, scales = "free_y", ncol = 2) +
scale_fill_manual(values = c("0" = "white", "1" = "skyblue")) +
scale_x_discrete(labels = c(
bias_confounding = "Bias & Confounding",
data_quality_accuracy = "Data Quality & Classification",
study_design_analytics = "Study Design & Analytics",
equity_validity_reporting = "Equity & Reporting",
data_integration_interoperability = "Data Integration & Interoperability",
others = "Others"
)) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 35, hjust = 1, size = 7),
axis.text.y = element_text(size = 2.8),
strip.text = element_text(size = 10),
aspect.ratio = 0.8,
panel.spacing = unit(0.3, "lines"),
legend.key.size = unit(0.6, "cm"),
legend.title = element_text(size = 10),
legend.text = element_text(size = 8)
) +
labs(x = NULL,
y = "Studies (by first author)",
fill = "Reported")
htmap
